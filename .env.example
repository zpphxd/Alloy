# Claude (owner research, outreach drafting, alternate qualifier)
ANTHROPIC_API_KEY=

# Qualifier engine: "jev" (default, TypeSafe Jev) or "claude"
PESCADORA_QUALIFIER=jev
TYPESAFE_API_KEY=
# Pin a dated Jev model for reproducible verdicts (see `client.models.list()`)
TYPESAFE_DEFAULT_MODEL=jev-latest

# ZoomInfo Enterprise API (owner resolution, scoops, intent, contacts)
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=

# Where the local SQLite database lives
PESCADORA_DB=data/pescadora.sqlite
