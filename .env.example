# Claude (owner research, outreach drafting, fallback qualifier)
ANTHROPIC_API_KEY=

# Qualifier engine: "claude" (default) or "jev" (TypeSafe Jev, once wired in)
PESCADORA_QUALIFIER=claude
TYPESAFE_API_KEY=

# ZoomInfo Enterprise API (owner resolution, scoops, intent, contacts)
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=

# Where the local SQLite database lives
PESCADORA_DB=data/pescadora.sqlite
